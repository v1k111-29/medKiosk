# ─── medKiosk — Environment Variables ────────────────────────────────────────
# Copy this file to .env (project root) and fill in your values.
# Read by app/core/config.py (pydantic-settings) on startup; real environment
# variables override .env.

# ── Mode ──────────────────────────────────────────────────────────────────────
# dev | prod. In prod, startup FAILS if JWT_SECRET is the default or
# KIOSK_DEVICE_KEYS is empty (and if CORS_ORIGINS contains "*").
ENV=dev

# ── Database ──────────────────────────────────────────────────────────────────
# Dev default: SQLite file in the project root.
DATABASE_URL=sqlite:///./patients.db
# Production (PostgreSQL, psycopg v3):
# DATABASE_URL=postgresql+psycopg://medkiosk:change-me@localhost:5432/medkiosk

# ── Groq (cloud speech-to-text + LLM) ─────────────────────────────────────────
# Free key: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# Chat / registration model
GROQ_MODEL=openai/gpt-oss-20b
# Triage model (smarter, used for department routing)
GROQ_TRIAGE_MODEL=openai/gpt-oss-120b
# Whisper model: whisper-large-v3-turbo (fast) | whisper-large-v3 (most accurate)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Timeouts (seconds)
GROQ_TIMEOUT=30
GROQ_WHISPER_TIMEOUT=30

# ── Sarvam AI (optional Indic speech: Tamil/English STT + TTS) ────────────────
# Key: https://dashboard.sarvam.ai   Docs: https://docs.sarvam.ai
# STT_PROVIDER: groq | sarvam   (sarvam falls back to groq on failure if GROQ_API_KEY set)
STT_PROVIDER=groq
# TTS_PROVIDER: browser | sarvam (browser = speechSynthesis in the kiosk; /tts returns 503)
TTS_PROVIDER=browser
SARVAM_API_KEY=REPLACE_ME
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
# Speakers are model-specific (bulbul:v3 names, lowercase)
SARVAM_TTS_SPEAKER_TA=kavitha
SARVAM_TTS_SPEAKER_EN=priya
SARVAM_TIMEOUT=30
# Max upload sent to Sarvam REST STT (bytes); larger clips go to Groq
SARVAM_STT_MAX_BYTES=2000000
# /tts is public but rate limited per client IP (requests/minute) and cached (entries)
TTS_RATE_LIMIT_PER_MIN=60
TTS_CACHE_SIZE=256

# ── Staff auth (JWT, HS256) ───────────────────────────────────────────────────
# MUST be changed in prod. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-secret
# Token lifetime in minutes (720 = one nurse shift)
JWT_EXPIRE_MINUTES=720

# ── Kiosk devices ─────────────────────────────────────────────────────────────
# Comma-separated device keys; each kiosk sends one as the X-Kiosk-Key header.
# Empty + ENV=dev = kiosk key check disabled. Required in prod.
KIOSK_DEVICE_KEYS=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API (kiosk :5173, staff :5174)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Face recognition ──────────────────────────────────────────────────────────
# ArcFace cosine distance threshold (lower = stricter)
FACE_MATCH_THRESHOLD=0.45
# Max stored embeddings per patient
FACE_GALLERY_SIZE=5

# ── SMS ───────────────────────────────────────────────────────────────────────
# mock (log only) | twilio
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender number in E.164, e.g. +15005550006
TWILIO_FROM_NUMBER=
# Used in the SMS text
HOSPITAL_NAME=City Hospital

# ── Phone OTP identification (visitors who decline face recognition) ─────────
# Code lifetime, wrong guesses allowed per code, and codes per phone per window.
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT=3
OTP_RATE_WINDOW_MINUTES=10
# Lifetime of the signed proof from /identify/phone/verify that /register requires
# when no face template is stored.
PHONE_VERIFICATION_TOKEN_MINUTES=15

# ── Consent / clinical rules ──────────────────────────────────────────────────
# Version label stored with each face consent; bump whenever the consent text changes.
CONSENT_VERSION=v1-2026-11
# Patients younger than this (years) are treated as children (paediatric routing, red flags).
CHILD_AGE_YEARS=14

# ── Seeding ───────────────────────────────────────────────────────────────────
# Create demo staff accounts (nurse1 / Nurse@123, admin / Admin@123) when the
# users table is empty. Set to false in production.
SEED_DEMO_USERS=true

# ── Docker Compose (production stack, see docs/DEPLOY.md) ─────────────────────
# PostgreSQL password for the compose `db` service (backend DATABASE_URL is built from it,
# overriding DATABASE_URL above). Use URL-safe characters, e.g. python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=change-me
# One of KIOSK_DEVICE_KEYS; the kiosk nginx adds it as X-Kiosk-Key (kept out of the JS bundle).
KIOSK_PROXY_KEY=
# false = smaller backend image without DeepFace/TensorFlow (phone + OTP identification only)
INSTALL_FACE=true
# Host ports for the kiosk and staff web apps
KIOSK_PORT=8080
STAFF_PORT=8081
