# ─── Hospital Kiosk — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your values.
# The server reads these on startup.

# ── REQUIRED: Ollama (local LLM) ─────────────────────────────────────────────
# Ollama must be running locally. Install: curl -fsSL https://ollama.com/install.sh | sh
# Then pull the model: ollama pull gemma3:4b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Timeout in seconds (longer for Raspberry Pi 5 CPU inference)
OLLAMA_TIMEOUT=120

# ── REQUIRED: Sarvam AI (voice transcription) ────────────────────────────────
# Get a Sarvam API key at: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_TIMEOUT=30

# ── OLD GROQ CLOUD CONFIG (commented out — replaced by local Ollama) ─────────
# Get a free Groq API key at: https://console.groq.com
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_TIMEOUT=30

# ── OPTIONAL: Face recognition ────────────────────────────────────────────────
# Cosine distance threshold for face match (lower = stricter)
FACE_MATCH_THRESHOLD=0.40

# ── OPTIONAL: Security ────────────────────────────────────────────────────────
# API key required for /register and /patients delete endpoints
# KIOSK_API_KEY=change-me-in-production

# CORS origins (comma-separated, * = allow all)
# KIOSK_CORS_ORIGINS=http://localhost:5173,http://localhost:8000
