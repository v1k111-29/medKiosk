# Copy to .env (or .env.local) and adjust.

# API base URL. Leave empty in dev to use the Vite proxy to http://localhost:8000.
VITE_API_URL=

# Device key for this kiosk; must be listed in the backend's KIOSK_DEVICE_KEYS.
# Sent as the X-Kiosk-Key header. Leave empty when the backend check is disabled (ENV=dev).
VITE_KIOSK_KEY=
